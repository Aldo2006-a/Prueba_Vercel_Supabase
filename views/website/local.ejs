<%_
    // Información descriptiva de los locales. No incluye precios ni pedidos.
    // "destacados" sale de lo que ya dice la descripción de cada local.
    const catalogoLocales = {
        1: {
            id: 1,
            nombre: 'Cafetería Central',
            imagen: '/assets/img/cafeteriaCentral.png',
